# Database
DATABASE_URL="postgresql://nichemaster:nichemaster_dev_password@localhost:5432/nichemaster_db"

# Redis
REDIS_URL="redis://:nichemaster_redis_password@localhost:6379"

# NextAuth (Authentication)
NEXTAUTH_SECRET="your-nextauth-secret-key-change-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Module 1: Niche Analysis APIs
# YouTube Data API v3 - https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY="your-youtube-api-key"

# Google Trends via SerpAPI - https://serpapi.com/
SERPAPI_KEY="your-serpapi-key"

# TikTok Creative Center (Optional)
TIKTOK_API_KEY="your-tiktok-api-key"

# Reddit API - https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID="your-reddit-client-id"
REDDIT_CLIENT_SECRET="your-reddit-client-secret"

# Twitter/X API v2 - https://developer.twitter.com/
TWITTER_BEARER_TOKEN="your-twitter-bearer-token"

# Module 2: Content Generation APIs
# OpenAI API - https://platform.openai.com/api-keys
OPENAI_API_KEY="your-openai-api-key"

# Anthropic Claude API - https://console.anthropic.com/
ANTHROPIC_API_KEY="your-anthropic-api-key"

# HeyGen API - https://app.heygen.com/
HEYGEN_API_KEY="your-heygen-api-key"

# Pictory API - https://pictory.ai/
PICTORY_API_KEY="your-pictory-api-key"

# ElevenLabs Voice API - https://elevenlabs.io/
ELEVENLABS_API_KEY="your-elevenlabs-api-key"

# Zapier Webhook (for auto-posting)
ZAPIER_WEBHOOK_URL="your-zapier-webhook-url"

# Canva API - https://www.canva.com/developers/
CANVA_API_KEY="your-canva-api-key"

# Storage (AWS S3 or Cloudflare R2)
S3_ACCESS_KEY_ID="your-s3-access-key"
S3_SECRET_ACCESS_KEY="your-s3-secret-key"
S3_BUCKET_NAME="nichemaster-videos"
S3_REGION="us-east-1"

# Optional: Cloudflare R2
R2_ACCOUNT_ID="your-r2-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key"
R2_SECRET_ACCESS_KEY="your-r2-secret-key"
R2_BUCKET_NAME="nichemaster-videos"

# Analytics & Monitoring
SENTRY_DSN="your-sentry-dsn"

# Environment
NODE_ENV="development"
